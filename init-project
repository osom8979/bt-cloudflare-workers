#!/usr/bin/env bash
#
# 템플릿에서 새 프로젝트를 만든다. 이름을 바꾸고, 호환성 날짜를 오늘로 올리고, 포트를 정하고,
# 템플릿에만 해당하는 문서를 지운 뒤 자신을 삭제한다. 템플릿 저장소 자체에서는 실행하지 않는다.
#
#   ./init-project <이름> [--port N]
#
# <이름> 은 Worker 이름이 된다. 소문자·숫자·대시만 쓰고 63자를 넘지 않는다.
# 포트를 주지 않으면 이름에서 정해 프로젝트마다 다른 포트를 쓰게 한다 (dev 는 N, e2e 는 N+1).
#
# 작업 트리가 깨끗해야 한다. 끝난 뒤 `git diff` 로 바뀐 내용을 확인하고 커밋한다.

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" || exit; pwd)
cd "$ROOT_DIR"

TEMPLATE_NAME=bt-cloudflare-workers
OLD_DEV_PORT=48891
OLD_E2E_PORT=48892

# 템플릿 이름이 들어 있는 파일. 이 스크립트 자신은 마지막에 삭제하므로 넣지 않는다.
NAME_FILES=(package.json package-lock.json wrangler.jsonc index.html src/react-app/App.tsx README.md)
PORT_FILES=(vite.config.ts check-all.sh README.md)
# `<!-- template-only:start -->` 와 `<!-- template-only:end -->` 사이를 지우는 문서.
DOC_FILES=(README.md CLAUDE.md)

usage() {
    echo "사용법: $(basename "$0") <이름> [--port N]"
    echo ""
    echo "템플릿을 <이름> 프로젝트로 바꿉니다. <이름> 은 Worker 이름이 되므로"
    echo "소문자·숫자·대시만 쓰고 63자를 넘지 않습니다."
    echo ""
    echo "옵션:"
    echo "  --port N   개발 서버 포트. e2e 는 N+1 을 씁니다. 기본값은 이름에서 정합니다."
    echo "  --help     이 도움말을 출력합니다"
}

fail() {
    echo "$1" 1>&2
    exit 1
}

# GNU sed 와 BSD sed 의 -i 차이를 감춘다.
sed_i() {
    if sed --version > /dev/null 2>&1; then
        sed -i "$@"
    else
        sed -i '' "$@"
    fi
}

NAME=""
DEV_PORT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --port) DEV_PORT=${2:-}; shift 2 ;;
        --port=*) DEV_PORT=${1#--port=}; shift ;;
        --help) usage; exit 0 ;;
        -*) echo "알 수 없는 옵션입니다: $1" 1>&2; usage 1>&2; exit 1 ;;
        *)
            if [ -n "$NAME" ]; then
                echo "이름은 하나만 줍니다: $NAME, $1" 1>&2
                usage 1>&2
                exit 1
            fi
            NAME=$1
            shift
            ;;
    esac
done

if [ -z "$NAME" ]; then
    usage 1>&2
    exit 1
fi
if [[ ! "$NAME" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] || [ ${#NAME} -gt 63 ]; then
    fail "이름은 소문자·숫자·대시만 쓰고, 대시로 시작하거나 끝나지 않으며, 63자를 넘지 않습니다: $NAME"
fi
if [ "$NAME" = "$TEMPLATE_NAME" ]; then
    fail "템플릿 이름과 다른 이름을 줍니다: $NAME"
fi
if [ -n "$DEV_PORT" ] && { [[ ! "$DEV_PORT" =~ ^[0-9]+$ ]] || [ "$DEV_PORT" -lt 1024 ] || [ "$DEV_PORT" -gt 65534 ]; }; then
    fail "포트는 1024 이상 65534 이하의 숫자입니다: $DEV_PORT"
fi
if ! git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    fail "git 저장소가 아닙니다. 바뀐 내용을 git 으로 확인할 수 있어야 합니다."
fi
if [ -n "$(git status --porcelain)" ]; then
    fail "작업 트리에 커밋하지 않은 변경이 있습니다. 먼저 커밋하거나 되돌립니다."
fi
for f in "${NAME_FILES[@]}" "${PORT_FILES[@]}" "${DOC_FILES[@]}"; do
    if [ ! -f "$f" ]; then
        fail "파일이 없습니다: $f"
    fi
done

if [ -z "$DEV_PORT" ]; then
    # 이름의 CRC 로 40000~48999 범위에서 정한다. 같은 이름이면 같은 포트가 나온다.
    CRC=$(cksum <<< "$NAME" | cut -d' ' -f1)
    DEV_PORT=$((40000 + CRC % 9000))
fi
E2E_PORT=$((DEV_PORT + 1))
TODAY=$(date +%F)

echo "== 이름: $TEMPLATE_NAME → $NAME"
sed_i "s/$TEMPLATE_NAME/$NAME/g" "${NAME_FILES[@]}"
sed_i '/"description": "Cloudflare Workers project template",/d' package.json

echo "== 포트: dev $OLD_DEV_PORT → $DEV_PORT, e2e $OLD_E2E_PORT → $E2E_PORT"
sed_i "s/$OLD_E2E_PORT/$E2E_PORT/g; s/$OLD_DEV_PORT/$DEV_PORT/g" "${PORT_FILES[@]}"

echo "== compatibility_date → $TODAY"
sed_i -E "s/\"compatibility_date\": \"[0-9]{4}-[0-9]{2}-[0-9]{2}\"/\"compatibility_date\": \"$TODAY\"/" wrangler.jsonc

echo "== 템플릿 전용 문서 삭제"
sed_i '/<!-- template-only:start -->/,/<!-- template-only:end -->/d' "${DOC_FILES[@]}"

if [ ! -d node_modules ]; then
    echo "== 의존성 설치"
    ./npm ci
fi

echo "== worker-configuration.d.ts 재생성"
./run cf-typegen

echo "== 문서 포맷"
./npx prettier --write "${DOC_FILES[@]}" package.json > /dev/null

rm -f "$ROOT_DIR/init-project"

REMAINING=$(git grep -l "$TEMPLATE_NAME" -- . ':!init-project' || true)
if [ -n "$REMAINING" ]; then
    fail "템플릿 이름이 남아 있습니다. 직접 바꿉니다:"$'\n'"$REMAINING"
fi

echo
echo "완료했습니다. 다음을 진행합니다."
echo "  1. git status 와 git diff 로 바뀐 내용을 확인한다"
echo "  2. 커밋한다 (init-project 삭제도 함께)"
echo "  3. ./check-all.sh 로 전체 점검을 통과시킨다"
echo "  4. README 의 'Cloudflare 연결'을 따라 로그인·시크릿·배포를 설정한다"
echo
echo "개발 서버: http://localhost:$DEV_PORT"
